{
  "name": "hcmut-bach-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --patch-dir ../patches",
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md --format pdf",
    "check:overflow": "node ../scripts/check-overflow.mjs --entry slides.md"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "patch-package": "8.0.1",
    "playwright-chromium": "1.63.0"
  },
  "overrides": {
    "@shikijs/vitepress-twoslash": "4.4.3"
  }
}
