{
  "name": "slidev-studio",
  "version": "1.0.2",
  "description": "Desktop app to manage and live-edit Slidev presentations",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Slidev Studio",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "install:app": "./scripts/install-mac-app.sh",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder",
    "test:desktop:prepare": "node scripts/prepare-desktop-tests.mjs",
    "test:report:prepare": "node scripts/prepare-report-tests.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:benchmark": "node scripts/benchmark.mjs",
    "test:export": "node scripts/export-smoke.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "execa": "^8.0.1",
    "fflate": "0.8.2",
    "fix-path": "^4.0.0",
    "fs-extra": "^11.2.0",
    "get-port": "^7.1.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "react-resizable-panels": "^2.1.9",
    "semver": "^7.8.5",
    "simple-git": "^3.27.0",
    "tree-kill": "^1.2.2",
    "uuid": "^10.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.8.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.395.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "5.4.624",
    "postcss": "^8.4.38",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  }
}
